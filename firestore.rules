rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOrderThread(data) {
      return data.keys().hasAll([
          'id', 'orderId', 'accessToken', 'customerName', 'customerPhone',
          'customerCity', 'total', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderId', 'accessToken', 'customerName', 'customerPhone',
          'customerCity', 'paymentMethod', 'itemsSummary', 'items', 'total',
          'status', 'statusLabel', 'createdAt', 'updatedAt', 'lastMessageText',
          'lastMessageSender', 'unreadForCustomer', 'unreadForAdmin',
          'referredByCode', 'referredByName'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.orderId is string && data.orderId.size() > 0 && data.orderId.size() <= 64
        && data.accessToken is string && data.accessToken.size() >= 16 && data.accessToken.size() <= 128
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 40
        && data.customerCity is string && data.customerCity.size() > 0 && data.customerCity.size() <= 160
        && data.total is number && data.total >= 0
        && data.status in ['discussion', 'pending', 'paid', 'delivered']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 80))
        && (!('itemsSummary' in data) || (data.itemsSummary is string && data.itemsSummary.size() <= 500))
        && (!('items' in data) || (data.items is list && data.items.size() <= 30))
        && (!('statusLabel' in data) || (data.statusLabel is string && data.statusLabel.size() <= 60))
        && (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 300))
        && (!('lastMessageSender' in data) || data.lastMessageSender in ['customer', 'merchant', 'system'])
        && (!('unreadForCustomer' in data) || (data.unreadForCustomer is number && data.unreadForCustomer >= 0))
        && (!('unreadForAdmin' in data) || (data.unreadForAdmin is number && data.unreadForAdmin >= 0))
        && (!('referredByCode' in data) || (data.referredByCode is string && data.referredByCode.size() <= 40))
        && (!('referredByName' in data) || (data.referredByName is string && data.referredByName.size() <= 100));
    }

    function isValidOrderChatMessage(data) {
      return data.keys().hasAll(['id', 'threadId', 'sender', 'senderName', 'text', 'createdAt'])
        && data.keys().hasOnly(['id', 'threadId', 'sender', 'senderName', 'text', 'createdAt', 'attachedProduct'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.threadId is string && data.threadId.size() > 0 && data.threadId.size() <= 64
        && data.sender in ['customer', 'merchant', 'system']
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 120
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('attachedProduct' in data) || data.attachedProduct is map);
    }

    function isValidDailyStat(data) {
      return data.keys().hasAll(['date', 'visits', 'pageViews', 'updatedAt'])
        && data.keys().hasOnly(['date', 'visits', 'pageViews', 'whatsappClicks', 'siteChatOrders', 'updatedAt'])
        && data.date is string && data.date.size() == 10 && data.date.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && data.visits is number && data.visits >= 0
        && data.pageViews is number && data.pageViews >= 0
        && (!('whatsappClicks' in data) || (data.whatsappClicks is number && data.whatsappClicks >= 0))
        && (!('siteChatOrders' in data) || (data.siteChatOrders is number && data.siteChatOrders >= 0))
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidCustomerReview(data) {
      return data.keys().hasAll(['id', 'authorName', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['id', 'authorName', 'city', 'rating', 'comment', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 600
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidPushConfig(data) {
      return data.keys().hasAll(['publicKey', 'privateKey', 'subject', 'createdAt'])
        && data.keys().hasOnly(['publicKey', 'privateKey', 'subject', 'createdAt'])
        && data.publicKey is string && data.publicKey.size() > 20 && data.publicKey.size() <= 256
        && data.privateKey is string && data.privateKey.size() > 20 && data.privateKey.size() <= 256
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 160
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidPushSubscription(data) {
      return data.keys().hasAll(['id', 'role', 'endpoint', 'keys', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'role', 'endpoint', 'keys', 'orderIds', 'userAgent', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.role in ['customer', 'admin']
        && data.endpoint is string && data.endpoint.size() >= 10 && data.endpoint.size() <= 1000
        && data.keys is map
        && data.keys.keys().hasAll(['p256dh', 'auth'])
        && data.keys.keys().hasOnly(['p256dh', 'auth'])
        && data.keys.p256dh is string && data.keys.p256dh.size() > 0 && data.keys.p256dh.size() <= 300
        && data.keys.auth is string && data.keys.auth.size() > 0 && data.keys.auth.size() <= 200
        && (!('orderIds' in data) || (data.orderIds is list && data.orderIds.size() <= 30))
        && (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 160))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Products: Public catalogue access for reading, writes allowed for catalog management
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Categories: Public reading, writes allowed
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId);
    }

    // Orders: Customers can submit orders via checkout, read & status update
    match /orders/{orderId} {
      allow read: if true;
      allow create, update, delete: if isValidId(orderId);
    }

    // Order chat threads (managed via server & validated strictly on structure)
    match /order_threads/{threadId} {
      allow read: if true;
      allow create: if isValidId(threadId) && isValidOrderThread(incoming());
      allow update: if isValidId(threadId)
        && isValidOrderThread(incoming())
        && incoming().id == existing().id
        && incoming().orderId == existing().orderId
        && incoming().accessToken == existing().accessToken
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(threadId);

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidId(threadId)
          && isValidId(messageId)
          && exists(/databases/$(database)/documents/order_threads/$(threadId))
          && isValidOrderChatMessage(incoming())
          && incoming().threadId == threadId;
        allow update, delete: if false;
      }
    }

    // Leads & CRM contacts:
    match /leads/{leadId} {
      allow read: if true;
      allow write: if isValidId(leadId);
    }

    // Team members & referral tracking:
    match /team_members/{memberId} {
      allow read: if true;
      allow write: if isValidId(memberId);
    }

    // Site settings & homepage banners (hero image, carousel photos)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Daily site visits & activity metrics (one document per YYYY-MM-DD day)
    match /daily_stats/{dateId} {
      allow read: if true;
      allow create, update: if isValidId(dateId)
        && dateId.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && isValidDailyStat(incoming())
        && incoming().date == dateId;
      allow delete: if false;
    }

    // Customer Reviews displayed dynamically on the storefront homepage
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId)
        && isValidCustomerReview(incoming())
        && incoming().id == reviewId;
      allow update: if false;
      allow delete: if isValidId(reviewId);
    }

    // Web Push VAPID key configuration
    match /push_config/{configId} {
      allow read: if isValidId(configId);
      allow create, update: if isValidId(configId) && isValidPushConfig(incoming());
      allow delete: if false;
    }

    // Web Push device subscriptions (customer order tracking & admin alerts)
    match /push_subscriptions/{subId} {
      allow read: if true;
      allow create, update: if isValidId(subId)
        && isValidPushSubscription(incoming())
        && incoming().id == subId;
      allow delete: if isValidId(subId);
    }

    // Fallback rule for test/connection probe
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
